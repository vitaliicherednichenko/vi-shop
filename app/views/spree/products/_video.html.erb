<% if product.video_url.present? %>
  <div class="product-video">
    <%
      video_url = product.video_url
      video_type = nil
      embed_url = nil

      if video_url.include?('youtube.com') || video_url.include?('youtu.be')
        video_type = 'youtube'
        video_id = if video_url.include?('youtu.be')
                     video_url.split('youtu.be/').last.split('?').first
                   else
                     video_url.split('v=').last.split('&').first
                   end
        embed_url = "https://www.youtube.com/embed/#{video_id}"
      elsif video_url.include?('vimeo.com')
        video_type = 'vimeo'
        video_id = video_url.split('/').last.split('?').first
        embed_url = "https://player.vimeo.com/video/#{video_id}"
      elsif video_url.include?('tiktok.com') || video_url.include?('vm.tiktok.com') || video_url.include?('vt.tiktok.com')
        video_type = 'tiktok'
      end
    %>

    <% if video_type == 'tiktok' %>
      <div class="tiktok-embed-container" style="max-width: 500px; margin: 0 auto;">
        <blockquote class="tiktok-embed" cite="<%= video_url %>" data-embed-type="video">
          <section>
            <a target="_blank" title="Go to TikTok" href="<%= video_url %>">
              View on TikTok
            </a>
          </section>
        </blockquote>
        <script async src="https://www.tiktok.com/embed.js" charset="utf-8"></script>
      </div>
    <% elsif embed_url.present? %>
      <div class="video-container" style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden;">
        <iframe
          style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"
          src="<%= embed_url %>"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen>
        </iframe>
      </div>
    <% end %>
  </div>
<% end %>

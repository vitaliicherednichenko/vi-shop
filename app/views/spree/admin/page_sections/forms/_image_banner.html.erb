<%= render 'spree/admin/shared/page_section_image', f: f %>

<div class="form-group">
  <%= f.label :preferred_image_url, Spree.t('admin.page_builder.image_url') %>
  <%= f.url_field :preferred_image_url, placeholder: 'https://example.com/image.jpg', data: { action: 'auto-submit#submit' }, class: "form-control" %>
  <span class="text-muted form-text mt-2"><%= Spree.t('admin.page_builder.image_url_hint') %></span>
</div>

<% content_for(:design_tab) do %>
  <div class="form-group">
    <%= f.label :preferred_vertical_alignment, Spree.t('admin.page_builder.vertical_alignment') %>
    <%= f.select :preferred_vertical_alignment, options_for_select([:top, :middle, :bottom], @page_section.preferred_vertical_alignment), {  }, { class: 'custom-select', data: {  action: 'auto-submit#submit' } } %>
  </div>

  <%= render 'spree/admin/page_builder/range_input',
  f: f, field: :preferred_overlay_transparency, min: 1, max: 100, unit: '%' %>

  <%= render 'spree/admin/page_sections/fields/height', f: f %>
<% end %>
